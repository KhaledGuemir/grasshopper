# ---------------------------------------------------------------------------
# Grasshopper Pasture — every variable here is OPTIONAL.
#
# Zero-config (recommended, and completely free):
#   npm run build && npm start
# or:
#   docker compose up -d
#
# That runs the app, room store, WebRTC signaling and the HTTP relay fallback
# in one Node process. No account, API key, database, TURN service or paid plan
# is needed.
# ---------------------------------------------------------------------------

# Stable HMAC key for room/session tokens. Recommended on a public server so
# tokens survive a restart. Generate with: openssl rand -hex 32
# If unset, the app generates a random per-process secret (or derives one from
# the Redis credentials on serverless).
# ROOM_SECRET=

# Optional shared store for multi-instance/serverless deployments. Leave unset
# for a single Node process (the zero-config default).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional extra STUN servers (comma separated). Public STUN needs no key.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Optional self-hosted TURN (coturn) for players behind symmetric NAT or a
# firewall that blocks UDP. See deploy/coturn/ and docs/SELF_HOSTING.md.
# TURN_URL=turn:YOUR_PUBLIC_IP:3478
# TURN_SECRET=change-me
# TURN_USERNAME=grasshopper
# TURN_CREDENTIAL=change-me

# Hide the multiplayer panel with 0. Default: visible.
# NEXT_PUBLIC_MULTIPLAYER=1

# Split deployment: serve the UI elsewhere and point it at this server's API.
# NEXT_PUBLIC_SIGNAL_URL=https://your-server.example.com
# CORS_ORIGIN=https://your-ui.example.com
