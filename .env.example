# Vercel Marketplace Redis / Upstash
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Direct Upstash fallback (either pair works)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required in production. Generate with: openssl rand -base64 32
ROOM_SECRET=

# Leave TURN unset for the no-paid-service setup. Vercel cannot host TURN and
# the game is STUN-only unless you explicitly add a free, hard-capped provider.
TURN_URL=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional feature flag
NEXT_PUBLIC_MULTIPLAYER=1

# Optional split deployment: Vercel UI + a separate local/tunneled signaling server.
# NEXT_PUBLIC_SIGNAL_URL=https://your-tunnel.example.com
# CORS_ORIGIN=https://your-app.vercel.app
